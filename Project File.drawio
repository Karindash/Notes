  <diagram id="jzKcN-bIppC0IgKCCzT4" name="CR61517 Seq Diagram Cek Status">
    <mxGraphModel dx="3027" dy="1361" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n\n    box SPE PREMISES\n        participant YAP as YAP! Mobile\n    end\n\n    participant F5_Ext as F5 (External)\n\n    box BNI PREMISES\n        participant HUB as Hub Server\n        participant F5_Int as F5\n        participant UBP as UBP\n    end\n\n    box DESTINATIONS\n        participant MPN as MPN\n        participant AHU as AHU\n    end\n\n    %% 1. Cek Status Request Sequence\n    YAP-&gt;&gt;F5_Ext: Cek Status Request\n    F5_Ext-&gt;&gt;HUB: Request\n\n    %% 2. Internal Status Check &amp; Processing\n    HUB-&gt;&gt;F5_Int: Request\n    F5_Int-&gt;&gt;UBP: Request\n\n    %% 3. External Interactions (Direct to MPN &amp; AHU, bypassing Leased Line)\n    UBP-&gt;&gt;MPN: Status Inquiry\n    MPN--&gt;&gt;UBP: Status Responses\n\n    UBP-&gt;&gt;AHU: Success Status (flagging)\n    AHU--&gt;&gt;UBP: Success Status (flagging)\n\n    %% 4. Outbound Response Sequence\n    UBP--&gt;&gt;F5_Int: Response\n    F5_Int--&gt;&gt;HUB: Response\n    HUB--&gt;&gt;F5_Ext: Response\n    F5_Ext--&gt;&gt;YAP: Cek Status Response&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="sXOiLtqfyZAFgEyD4oy6-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
