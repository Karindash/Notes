        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {\n  &#39;theme&#39;: &#39;base&#39;,\n  &#39;themeVariables&#39;: {\n    &#39;primaryColor&#39;: &#39;#fff&#39;,\n    &#39;edgeLabelBackground&#39;:&#39;#fff&#39;,\n    &#39;tertiaryColor&#39;: &#39;#fff&#39;\n  },\n  &#39;flowchart&#39;: {\n    &#39;nodeSpacing&#39;: 50,\n    &#39;rankSpacing&#39;: 70,\n    &#39;curve&#39;: &#39;basis&#39;\n  }\n}%%}\n\ngraph LR\n    %% Judul Diagram (di luar flowchart utama agar posisinya pas)\n    title[SNAP VA Open Loop (Non-BNI Channel)]\n    \n    %% === Definisi Node (Komponen) ===\n    %% Gunakan tanda kurung siku ([ ]) untuk kotak sudut melengkung\n    N1(Non-BNI Channel)\n    N2(Switcher)\n    N3(MPG)\n    N4(Basic Banking)\n    N5(Smart VA)\n    \n    %% Komponen F5 (dibuat kotak dan kecil agar terlihat vertikal)\n    F1([F5])\n    \n    N6(Microservice)\n    N7(Core Service)\n    N8(Icons)\n    \n    F2([F5])\n    \n    N9(SPE)\n\n    %% === Subgraph untuk menata tata letak (Layout Grouping) ===\n    %% Ini trik agar komponen F5 dan elemen di sekitarnya sejajar sempurna\n    subgraph Group_1 [ ]\n        direction TB\n        N5 --&gt; F1\n    end\n    \n    subgraph Group_2 [ ]\n        direction TB\n        F1 --&gt; N6\n        N6 --&gt; F2\n        F2 --&gt; N9\n    end\n\n    %% === Definisi Koneksi (Alur Panah) ===\n    %% Alur Kiri\n    N1 --&gt;| | N2\n    N2 --&gt;| | N3\n    N3 --&gt;| | N4\n    N4 --&gt;| | N5\n    \n    %% Alur Kanan\n    N6 --&gt;| | N7\n    N7 --&gt;| | N8\n\n    %% Styling khusus untuk node F5 agar terlihat panjang dan tipis\n    %% (Catatan: Fitur styling inline terbatas di beberapa viewer Mermaid, \n    %% tapi struktur graph di atas sudah memaksa bentuk vertikal)\n    classDef f5Shape fill:#fff,stroke:#333,stroke-width:2px,rx:5,ry:5,min-height:100px;\n    class F1,F2 f5Shape;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="LSonYEGRImZilLj9RDxp-1">
