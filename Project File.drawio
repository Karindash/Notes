        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    subgraph SPE [\&quot;SPE PREMISES\&quot;]\n        YAP[\&quot;YAP APPLICATION\&quot;]\n    end\n\n    F5([\&quot;F5\&quot;])\n\n    subgraph BNI [\&quot;BNI PREMISES\&quot;]\n        HUB[\&quot;HUB Server\&quot;]\n        BASE24[\&quot;BASE 24\&quot;]\n        SOA[\&quot;SOA\&quot;]\n    end\n\n    subgraph AHU [\&quot;AHU PREMISES\&quot;]\n        MPNG[\&quot;MPNG\&quot;]\n    end\n\n    %% Relasi / Alur Data\n    YAP --&gt; F5\n    F5 --&gt; HUB\n    \n    HUB -- \&quot;Manage Card\&quot; --&gt; BASE24\n    BASE24 -- \&quot;Response\&quot; --&gt; HUB\n    \n    HUB -- \&quot;Card Verify\&quot; --&gt; SOA\n    HUB -- \&quot;AHU Payment\&quot; --&gt; SOA\n    \n    SOA -- \&quot;AHU Payment\&quot; --&gt; MPNG\n    MPNG -- \&quot;Response\&quot; --&gt; SOA\n    SOA -- \&quot;Response\&quot; --&gt; HUB\n    \n    HUB --&gt; F5\n    F5 --&gt; YAP\n\n    %% Styling Warna (mendekati gambar asli)\n    classDef spe fill:#9e1b2f,stroke:#333,stroke-width:1px,color:#fff,rx:10,ry:10;\n    classDef f5 fill:#e6e6fa,stroke:#a6a6f4,stroke-width:2px,rx:15,ry:15;\n    classDef hub fill:#ff8c00,stroke:#333,stroke-width:1px,color:#fff,rx:5,ry:5;\n    classDef base fill:#5b6e7f,stroke:#333,stroke-width:1px,color:#fff,rx:10,ry:10;\n    classDef soa fill:#fdf885,stroke:#333,stroke-width:1px,rx:10,ry:10;\n    classDef mpng fill:#f0f0f0,stroke:#333,stroke-width:1px,rx:15,ry:15;\n\n    class YAP spe;\n    class F5 f5;\n    class HUB hub;\n    class BASE24 base;\n    class SOA soa;\n    class MPNG mpng;\n    \n    %% Styling Garis (Garis biru untuk Response)\n    linkStyle 3,7,8,9,10 stroke:#0000FF,stroke-width:2px,color:#000;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="r32cQzo05K1YreNqzX9z-1">
